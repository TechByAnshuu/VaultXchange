# ==========================================
# VaultXchange — .gitignore
# ==========================================

# Node.js
node_modules/
dist/
dist-ssr/
*.local

# Environment files — NEVER push real secrets
.env
.env.production
frontend/.env
frontend/.env.production

# Keep these — they are safe templates
# .env.example          ✅ pushed to GitHub
# frontend/.env.example ✅ pushed to GitHub

# Maven / Java
target/
*.class
*.jar
*.war
*.ear
*.log

# IDE files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Temporary files
tmp/
temp/
