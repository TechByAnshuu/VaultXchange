 ==========================================
# VaultXchange — .env.example
# ==========================================
# Copy this file → rename to .env
# Fill in your actual values
# NEVER commit .env to GitHub

# ==========================================
# Backend Configuration
# ==========================================

# MongoDB Atlas Connection String
# Get from: Atlas → Connect → Drivers → Java
# Replace xxxxx with your actual cluster ID
# Replace <password> with your actual password (encode @ as %40)
MONGODB_URI=your_mongodb_connection_string_here

# Server Port
PORT=8082

# Frontend URL (for CORS)
# Local dev  → http://localhost:5173
# Production → https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ==========================================
# Frontend Configuration
# ==========================================

# Backend API URL
# Local dev  → http://localhost:8082/api
# Production → https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:8082/api

# ==========================================
# Gmail SMTP — Low Balance Alert Emails
# ==========================================
# Steps to get an App Password:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (enable if not already)
#   3. Security → App Passwords → Select "Mail" → Generate
#   4. Copy the 16-character password into MAIL_PASSWORD below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here

# Alert fires when account balance drops AT OR BELOW this value (in ₹)
ALERT_THRESHOLD=1000

# Alert fires when a single transaction amount is AT OR ABOVE this value (in ₹)
ALERT_AMOUNT_THRESHOLD=5000